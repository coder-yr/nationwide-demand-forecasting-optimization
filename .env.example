# Environment Configuration Template
# Copy to .env for local runtime overrides

ENVIRONMENT=production
DEBUG=False
PORT_API=8000
PORT_DASHBOARD=8050

# Security & CORS
ALLOWED_ORIGINS=http://localhost:8050,http://127.0.0.1:8050,http://localhost:3000

# Optimization Default Assumptions
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=3
DEFAULT_DAILY_BUDGET=50000.0
DEFAULT_STORAGE_CAPACITY_M3=1500.0

# OpenMP / Intel MKL Workaround on Windows
KMP_DUPLICATE_LIB_OK=TRUE

